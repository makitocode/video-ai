# ---------------------------------------------------------------------------
# Versión LOCAL — todo opcional.
#
# La aplicación arranca y funciona de extremo a extremo SIN configurar nada:
# usa proveedores simulados para la transcripción y el resumen. Copia este
# archivo a .env.local sólo cuando quieras resultados reales.
# ---------------------------------------------------------------------------

# Transcripción real con diarización y detección de idioma.
# SIN ESTA CLAVE el transcript es SINTÉTICO: no proviene de tu audio.
# Se consigue en https://www.assemblyai.com/dashboard/api-keys
# (registro sin tarjeta, con crédito gratis para unas 185 horas).
#
# Esta línea va SIN «#» delante: una variable comentada no se lee, y el
# síntoma es el mismo que no haberla escrito.
ASSEMBLYAI_API_KEY=""

# Idioma del audio en código ISO (es, en, pt...). Si se deja sin definir, el
# proveedor lo detecta solo. Fijarlo es más fiable cuando ya se sabe cuál es:
# un idioma mal detectado arruina el transcript entero.
# TRANSCRIPTION_LANGUAGE="es"

# Descripción del audio en lenguaje natural. Es la palanca de precisión más
# rentable que existe: el modelo la usa para desambiguar jerga y nombres propios
# que de otro modo transcribiría mal. Una o dos frases bastan.
# TRANSCRIPTION_PROMPT="Reunión de seguimiento en español entre el equipo comercial y los voceros de la marca, sobre resultados trimestrales y presupuesto."

# Vocabulario exacto separado por comas: nombres de personas, empresas,
# productos, siglas. Hasta 1.000 entradas de 6 palabras como máximo cada una.
# TRANSCRIPTION_KEYTERMS="Verdemonte,María González,EBITDA,Q3"

# Modelos de transcripción, del preferido al de reserva. Rara vez hay que
# tocarlo: por defecto se usa el insignia con reserva al de cobertura amplia.
# ASSEMBLYAI_SPEECH_MODELS="universal-3-5-pro,universal-2"

# Resumen real con Claude. Sin esta clave se genera un resumen simulado
# (con citas que sí apuntan a momentos reales del transcript).
#   https://console.anthropic.com/  → API Keys
# ANTHROPIC_API_KEY="sk-ant-..."

# Modelo a usar para el resumen. Por defecto: claude-opus-5
# ANTHROPIC_MODEL="claude-opus-5"

# Dónde guardar la base de datos y los archivos de medios.
# Por defecto: ./.data  (ya está en .gitignore)
# VIDEO_AI_DATA_DIR="/ruta/absoluta"
